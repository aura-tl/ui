{
  "id": "aura.line-movement.react-next",
  "component": "line-movement",
  "dataPlane": "aura-only",
  "deliveryMode": "poll",
  "dataManifest": {
    "version": 1,
    "component": "line-movement",
    "delivery": {
      "primary": "poll",
      "snapshot": [
        "game-card",
        "odds-timeline"
      ],
      "poll": {
        "everyMs": 60000,
        "transport": "request-metered-rest"
      }
    },
    "requests": [
      {
        "id": "game-card",
        "method": "GET",
        "path": "/api/games/{gameId}",
        "view": "card",
        "fields": [
          "id",
          "teams.away.abbreviation",
          "teams.home.abbreviation"
        ]
      },
      {
        "id": "odds-timeline",
        "method": "GET",
        "path": "/api/games/{gameId}/odds/timeline",
        "view": "chart-ready-market",
        "fields": [
          "gameId",
          "marketType",
          "points[].observedAt",
          "points[].outcomes[].side",
          "points[].outcomes[].line",
          "points[].outcomes[].price"
        ],
        "parameters": [
          "marketType={moneyline|spread|total}",
          "limit={2..500}",
          "fields={points.observedAt,points.outcomes.side,points.outcomes.line,points.outcomes.price}"
        ]
      },
      {
        "id": "activation-coverage",
        "method": "GET",
        "path": "/api/coverage",
        "view": "product-coverage",
        "fields": [
          "sports[].sport",
          "sports[].availability"
        ]
      }
    ],
    "relationships": [
      "Game.id -> OddsTimeline.gameId",
      "Game.teams.{side}.abbreviation -> rendered series label"
    ],
    "unavailable": [
      "Fewer than two retained market points renders line history unavailable.",
      "No historical points are synthesized from the current price."
    ]
  },
  "objects": [
    "Game",
    "OddsTimeline",
    "Coverage"
  ],
  "instructions": [
    "Render auraLineMovementFixture first.",
    "Pass one game id and one market type to useAuraLineMovement().",
    "This chart shows retained market observations only."
  ],
  "customization": {
    "howTo": "To pull more or fewer fields, edit the fields= list in this component\u2019s client and the matching *-types.ts. Allowlists are published per object in GET /api/catalog (fieldCatalog); unknown or duplicate fields return 400.",
    "fieldCatalogObjects": [
      "game-detail",
      "odds-timeline"
    ],
    "docs": "docs/component-data-customization.md"
  }
}
