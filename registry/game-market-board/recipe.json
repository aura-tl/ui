{
  "id": "aura.game-market-board.react-next",
  "component": "game-market-board",
  "dataPlane": "aura-only",
  "deliveryMode": "poll",
  "dataManifest": {
    "version": 1,
    "component": "game-market-board",
    "delivery": {
      "primary": "poll",
      "snapshot": [
        "game-card",
        "selected-odds-timeline"
      ],
      "poll": {
        "everyMs": 60000,
        "transport": "request-metered-rest"
      }
    },
    "requests": [
      {
        "id": "game-card",
        "method": "GET",
        "path": "/api/games/{gameId}",
        "view": "card",
        "fields": [
          "id",
          "league",
          "phase",
          "statusDetail",
          "teams.away",
          "teams.home"
        ]
      },
      {
        "id": "selected-odds-timeline",
        "method": "GET",
        "path": "/api/games/{gameId}/odds/timeline",
        "view": "chart-ready-market",
        "fields": [
          "gameId",
          "marketType",
          "points[].observedAt",
          "points[].outcomes[].side",
          "points[].outcomes[].line",
          "points[].outcomes[].price"
        ],
        "parameters": [
          "marketType={moneyline|spread|total}",
          "limit={1..500}",
          "fields={points.observedAt,points.outcomes.side,points.outcomes.line,points.outcomes.price}"
        ]
      },
      {
        "id": "activation-coverage",
        "method": "GET",
        "path": "/api/coverage",
        "view": "product-coverage",
        "fields": [
          "sports[].sport",
          "sports[].availability"
        ]
      }
    ],
    "relationships": [
      "Game.id -> OddsTimeline.gameId"
    ],
    "unavailable": [
      "Only the selected game market is requested.",
      "Props, parlays, bet placement, and unsupported market history are not implied."
    ]
  },
  "objects": [
    "Game",
    "OddsTimeline",
    "Coverage"
  ],
  "instructions": [
    "Render the fixture first.",
    "Keep the selected market in client state and pass it to useAuraGameMarketBoard().",
    "Switching tabs requests only that market; do not fan out across a slate."
  ],
  "customization": {
    "howTo": "To pull more or fewer fields, edit the fields= list in this component\u2019s client and the matching *-types.ts. Allowlists are published per object in GET /api/catalog (fieldCatalog); unknown or duplicate fields return 400.",
    "fieldCatalogObjects": [
      "game-detail",
      "odds-timeline"
    ],
    "docs": "docs/component-data-customization.md"
  }
}
