{
  "id": "player-prop-board",
  "displayName": "Aura Player Prop Board",
  "framework": "react-next-app-router",
  "deliveryMode": "poll",
  "dataPlane": "aura-only",
  "dataManifest": {
    "version": 1,
    "component": "player-prop-board",
    "delivery": {
      "primary": "poll",
      "snapshot": ["player-props"],
      "poll": {
        "everyMs": 120000,
        "transport": "request-metered-rest"
      }
    },
    "requests": [
      {
        "id": "player-props",
        "method": "GET",
        "path": "/api/games/{gameId}/props",
        "view": "board",
        "fields": [
          "gameId",
          "generatedAt",
          "props[].id",
          "props[].definition.id",
          "props[].definition.label",
          "props[].definition.category",
          "props[].definition.unit",
          "props[].player.id",
          "props[].player.name",
          "props[].player.teamId",
          "props[].line",
          "props[].outcomes[].side",
          "props[].outcomes[].price",
          "props[].status",
          "props[].observedAt",
          "props[].settlement.result",
          "props[].settlement.outcome",
          "props[].settlement.status",
          "props[].settlement.settledAt"
        ],
        "parameters": [
          "category={batting|pitching|...}",
          "playerId={Aura player id}"
        ]
      },
      {
        "id": "activation-coverage",
        "method": "GET",
        "path": "/api/coverage",
        "view": "product-coverage",
        "fields": ["sports[].sport", "sports[].availability"]
      }
    ],
    "relationships": ["Game.id -> PlayerProps.gameId"],
    "unavailable": [
      "A game without linked props renders unavailable and never fixture prices.",
      "Unlinked player identities and unsupported prop definitions stay internal to Aura."
    ]
  },
  "objects": ["Game", "PlayerProps", "Coverage"],
  "requires": ["react", "next"],
  "registryDependencies": ["live-scoreboard"],
  "files": [
    {
      "source": "player-prop-board-types.ts",
      "destination": "lib/aura/player-prop-board-types.ts"
    },
    {
      "source": "use-player-prop-board.ts",
      "destination": "hooks/aura/use-player-prop-board.ts"
    },
    {
      "source": "player-prop-board.tsx",
      "destination": "components/aura/player-prop-board.tsx"
    },
    {
      "source": "player-prop-board.css",
      "destination": "styles/aura-player-prop-board.css"
    },
    {
      "source": "fixture.ts",
      "destination": "fixtures/aura/player-prop-board.ts"
    },
    {
      "source": "recipe.json",
      "destination": "aura/recipes/player-prop-board.json"
    }
  ],
  "nextSteps": [
    "1. Import styles/aura-player-prop-board.css once.",
    "2. Render the fixture immediately.",
    "3. Bind the Aura client and one game id; optionally pass a category."
  ]
}
