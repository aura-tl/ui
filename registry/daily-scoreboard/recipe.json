{
  "id": "aura.daily-scoreboard.react-next",
  "component": "daily-scoreboard",
  "dataPlane": "aura-only",
  "deliveryMode": "poll",
  "dataManifest": {
    "version": 1,
    "component": "daily-scoreboard",
    "delivery": {
      "primary": "poll",
      "snapshot": [
        "daily-slate"
      ],
      "poll": {
        "everyMs": 30000,
        "while": "contains-live-game",
        "transport": "request-metered-rest"
      }
    },
    "requests": [
      {
        "id": "daily-slate",
        "method": "GET",
        "path": "/api/games",
        "view": "scoreboard",
        "fields": [
          "id",
          "sport",
          "league",
          "phase",
          "statusText",
          "statusDetail",
          "startsAtMs",
          "updatedAt",
          "teams.away.id",
          "teams.away.abbreviation",
          "teams.away.displayName",
          "teams.away.score",
          "teams.home.id",
          "teams.home.abbreviation",
          "teams.home.displayName",
          "teams.home.score"
        ],
        "parameters": [
          "date={YYYY-MM-DD}",
          "sport={sport}",
          "status={phase}",
          "limit={1..100}"
        ]
      },
      {
        "id": "activation-coverage",
        "method": "GET",
        "path": "/api/coverage",
        "view": "product-coverage",
        "fields": [
          "sports[].sport",
          "sports[].availability"
        ]
      }
    ],
    "relationships": [
      "Each Game.id is the detail link for its score row"
    ],
    "unavailable": [
      "An empty date renders an empty slate state.",
      "Missing scores remain an em dash for scheduled games and are never synthesized."
    ]
  },
  "objects": [
    "Game",
    "Coverage"
  ],
  "instructions": [
    "Render auraDailyScoreboardFixture first.",
    "Pass a UTC YYYY-MM-DD date and optional supported sport to useAuraDailyScoreboard().",
    "The component makes one bounded scoreboard request for the slate and polls only while a game is live."
  ],
  "customization": {
    "howTo": "To pull more or fewer fields, edit the fields= list in this component\u2019s client and the matching *-types.ts. Allowlists are published per object in GET /api/catalog (fieldCatalog); unknown or duplicate fields return 400.",
    "fieldCatalogObjects": [
      "game"
    ],
    "docs": "docs/component-data-customization.md"
  }
}
